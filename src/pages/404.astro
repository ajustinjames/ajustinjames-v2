---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="The page you were looking for doesn't exist.">
	<div class="max-w-3xl mx-auto py-24">
		<p
			class="font-mono text-sm uppercase tracking-widest text-lightTextSecondary dark:text-darkTextSecondary"
		>
			Error / Page Not Found
		</p>
		<h1
			class="mt-4 text-8xl md:text-9xl font-bold tracking-tight text-lightTextPrimary dark:text-darkTextPrimary"
		>
			404
		</h1>
		<div class="mt-4 h-1.5 w-24 bg-primary" aria-hidden="true"></div>
		<p class="mt-6 max-w-prose text-lightTextSecondary dark:text-darkTextSecondary">
			The page you were looking for doesn't exist or has been moved.
		</p>
		<div
			class="mt-8"
			set:html={`<hl-btn variant="primary"><a href="/">Back to home</a></hl-btn>`}
		/>
	</div>
</Layout>
