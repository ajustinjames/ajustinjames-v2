---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="The page you were looking for doesn't exist.">
	<div class="not-found">
		<p class="eyebrow">Error / Page Not Found</p>
		<h1 class="not-found__code">404</h1>
		<div class="not-found__rule" aria-hidden="true"></div>
		<p class="not-found__message">
			The page you were looking for doesn't exist or has been moved.
		</p>
		<div class="not-found__action">
			<hl-btn variant="primary"><a href="/">Back to home</a></hl-btn>
		</div>
	</div>
</Layout>

<style>
	.not-found {
		max-width: 48rem;
		margin-inline: auto;
		padding-block: 6rem;
	}

	.not-found__code {
		margin-top: 1rem;
		font-size: 6rem;
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--hl-alias-text-main);
	}

	.not-found__rule {
		margin-top: 1rem;
		width: 6rem;
		height: 0.375rem;
		background: var(--hl-alias-action-bg-primary);
	}

	.not-found__message {
		margin-top: 1.5rem;
		max-width: 65ch;
		color: var(--hl-alias-text-muted);
	}

	.not-found__action {
		margin-top: 2rem;
	}

	@media (min-width: 48rem) {
		.not-found__code {
			font-size: 8rem;
		}
	}
</style>
