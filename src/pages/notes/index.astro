---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { getCollection, render } from 'astro:content';
import { noteAnchor } from '../../utils/feed';

const notesDescription =
  'Short thoughts from Aaron James — a tweet-style microblog, newest first.';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const rendered = await Promise.all(
  notes.map(async (note) => ({
    note,
    anchor: noteAnchor(note.slug),
    Content: (await render(note)).Content,
    formattedDate: new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(note.data.pubDate),
  })),
);
---

<Layout title="Notes" description={notesDescription}>
  <Section
    eyebrow="Notes"
    title="Recent Notes"
    description={notesDescription}
    as="h1"
    width="narrow"
  >
    {
      rendered.length === 0 && (
        <p class="font-mono text-sm uppercase tracking-widest text-lightTextSecondary dark:text-darkTextSecondary">
          No notes yet.
        </p>
      )
    }
    <ul class="space-y-6">
      {
        rendered.map(({ note, anchor, Content, formattedDate }) => (
          <li id={anchor} class="hl-card-shell scroll-mt-24">
            <a
              href={`#${anchor}`}
              class="inline-block font-mono text-sm uppercase tracking-widest text-lightTextSecondary dark:text-darkTextSecondary hover:text-primary"
            >
              <time datetime={note.data.pubDate.toISOString()}>{formattedDate}</time>
            </a>
            <div class="prose prose-zinc dark:prose-invert max-w-none mt-3">
              <Content />
            </div>
            {note.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {note.data.tags.map((tag) => (
                  <hl-tag>{tag.toUpperCase()}</hl-tag>
                ))}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
