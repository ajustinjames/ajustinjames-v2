---
// Visually hidden until focused; the first tab stop on every page.
---

<a href="#main-content" class="skip-link">Skip to content</a>

<style>
	.skip-link {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.skip-link:focus {
		top: 1rem;
		left: 1rem;
		z-index: 50;
		width: auto;
		height: auto;
		margin: 0;
		padding: 0.5rem 1rem;
		overflow: visible;
		clip-path: none;
		background: var(--hl-alias-action-bg-primary);
		color: var(--hl-alias-action-color-primary);
		text-decoration: none;
	}
</style>
