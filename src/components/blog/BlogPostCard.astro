---
import TagList from './TagList.astro';

interface Props {
	title: string;
	description: string;
	url: string;
	pubDate: Date;
	tags?: string[];
}
const { title, description, url, pubDate, tags } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC'
}).format(pubDate);
---

<div class="hl-card-shell hover-lift post-card">
	<time datetime={pubDate.toISOString()} class="meta-date">
		{formattedDate}
	</time>

	<h3 class="card-title post-card__title">
		<a href={url}>{title}</a>
	</h3>

	<p class="post-card__description">{description}</p>

	{tags && tags.length > 0 && (
		<div class="post-card__tags">
			<TagList tags={tags} />
		</div>
	)}

	<div class="post-card__more">
		<span>Read more</span>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
		</svg>
	</div>
</div>

<style>
	.post-card {
		position: relative;
	}

	.post-card__title {
		margin-top: 0.5rem;
		letter-spacing: -0.025em;
	}

	/* Stretch the title link over the whole card. */
	.post-card__title a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.post-card__description {
		display: -webkit-box;
		margin-top: 0.75rem;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		color: var(--hl-alias-text-muted);
	}

	/* Above the stretched link so the tags stay clickable. */
	.post-card__tags {
		position: relative;
		z-index: 10;
		margin-top: 0.75rem;
	}

	.post-card__more {
		display: flex;
		align-items: center;
		margin-top: 1rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--hl-alias-action-bg-primary);
	}

	.post-card__more svg {
		width: 1rem;
		height: 1rem;
		margin-left: 0.5rem;
		transition: translate 0.15s;
	}

	@media (hover: hover) {
		.post-card:hover .post-card__title {
			color: var(--hl-alias-action-bg-primary);
		}

		.post-card:hover .post-card__more span {
			text-decoration: underline;
		}

		.post-card:hover .post-card__more svg {
			translate: 0.25rem 0;
		}
	}
</style>
