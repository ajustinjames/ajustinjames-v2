---
interface Props {
		tags: string[];
}
const { tags } = Astro.props;

function tagSlug(tag: string) {
	return tag.toLowerCase().replace(/\s+/g, '-');
}
---

<div class="tag-list">
	{tags.map((tag) => (
		<a href={`/blog/tags/${tagSlug(tag)}`}>
			<hl-tag>{tag.toUpperCase()}</hl-tag>
		</a>
	))}
</div>

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag-list a {
		text-decoration: none;
	}
</style>
