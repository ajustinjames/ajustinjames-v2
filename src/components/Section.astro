---
// Shared section wrapper carrying one content width, the site's vertical
// rhythm, and the hardline eyebrow-heading pattern (mono uppercase eyebrow +
// bold heading + hard accent rule). Used by home sections (h2) and page
// headers (h1) so every section reads as one system.
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	id?: string;
	as?: "h1" | "h2";
	width?: "wide" | "narrow";
	class?: string;
}

const {
	eyebrow,
	title,
	description,
	id,
	as = "h2",
	width = "wide",
	class: className,
} = Astro.props;

const Heading = as;
---

<section id={id} class:list={["section", `section--${width}`, className]}>
	<slot name="top" />
	<header class="section__header">
		<p class="eyebrow">{eyebrow}</p>
		<Heading class="section__title">{title}</Heading>
		<div class="section__rule" aria-hidden="true"></div>
		{description && <p class="section__description">{description}</p>}
	</header>
	<slot />
</section>

<style>
	.section {
		width: 100%;
		margin-inline: auto;
		padding-block: 3rem;
	}

	.section--wide {
		max-width: 72rem;
	}

	.section--narrow {
		max-width: 56rem;
	}

	.section__header {
		margin-bottom: 2rem;
	}

	/* The heading's tag is dynamic, so it's styled through its parent. */
	.section__header > :global(.section__title) {
		margin-top: 0.75rem;
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--hl-alias-text-main);
	}

	.section__rule {
		margin-top: 1rem;
		width: 3rem;
		height: 0.25rem;
		background: var(--hl-alias-action-bg-primary);
	}

	.section__description {
		margin-top: 1rem;
		max-width: 65ch;
		color: var(--hl-alias-text-muted);
	}

	@media (min-width: 48rem) {
		.section {
			padding-block: 4rem;
		}

		.section__header {
			margin-bottom: 2.5rem;
		}

		.section__header > :global(.section__title) {
			font-size: 2.25rem;
			line-height: 2.5rem;
		}
	}
</style>
