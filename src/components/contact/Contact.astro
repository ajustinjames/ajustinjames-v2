---
import Section from "../Section.astro";

const contactFormUrl: string = import.meta.env.CONTACT_FORM_URL;
const turnstileSiteKey: string = import.meta.env.TURNSTILE_SITE_KEY;
---

<Section id="contact" eyebrow="Contact" title="Get in Touch">
	<div class="hl-card-shell">
		<div id="form-feedback-container" class="contact__feedback"></div>
		<form id="contact-form" method="POST" class="contact__form">
			<div>
				<hl-input label-for="contact-name">
					<label slot="label" for="contact-name">Name</label>
					<input type="text" id="contact-name" name="name" required />
				</hl-input>
			</div>
			<div>
				<hl-input label-for="contact-email">
					<label slot="label" for="contact-email">Email</label>
					<input type="email" id="contact-email" name="email" required />
				</hl-input>
			</div>
			<div>
				<hl-input label-for="contact-message">
					<label slot="label" for="contact-message">Message</label>
					<textarea id="contact-message" name="message" required rows="5"></textarea>
				</hl-input>
			</div>
			<div class="contact__actions">
				<div class="contact__buttons">
					<span>
						<hl-btn variant="primary" size="md"><button type="submit" id="submit-btn">Send</button></hl-btn>
					</span>
					<span>
						<hl-btn variant="ghost" size="md"><button type="reset">Clear</button></hl-btn>
					</span>
					<hl-spinner id="submit-spinner" size="sm" label="Sending..." hidden></hl-spinner>
				</div>
				{
					turnstileSiteKey && (
						<div class="cf-turnstile contact__turnstile" data-sitekey={turnstileSiteKey} data-size="flexible"></div>
					)
				}
			</div>
		</form>
	</div>
</Section>

<style>
	.contact__feedback {
		margin-bottom: 1.5rem;
	}

	.contact__form > :not(:last-child) {
		margin-bottom: 1.5rem;
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1rem;
	}

	.contact__buttons {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.contact__turnstile {
		width: 100%;
	}

	@media (min-width: 40rem) {
		.contact__turnstile {
			width: auto;
		}
	}
</style>

<script
	src="https://challenges.cloudflare.com/turnstile/v0/api.js"
	async
	defer
	is:inline></script>

<script define:vars={{ contactFormUrl }} is:inline>
	const form = document.getElementById("contact-form");
	const feedbackContainer = document.getElementById("form-feedback-container");
	const submitWrapper = document.getElementById("submit-btn")?.closest("hl-btn");
	const submitBtn = document.getElementById("submit-btn");
	const spinner = document.getElementById("submit-spinner");

	// <hl-alert> is created on first use so the empty container takes no space.
	let feedback = null;

	function showFeedback(message, isSuccess) {
		if (!feedbackContainer) return;
		if (!feedback) {
			feedback = document.createElement("hl-alert");
			feedback.id = "form-feedback";
			feedback.setAttribute("aria-live", "polite");
			feedbackContainer.appendChild(feedback);
		}
		feedback.textContent = message;
		feedback.setAttribute("tone", isSuccess ? "success" : "error");
		feedback.removeAttribute("hidden");
		if (isSuccess) {
			setTimeout(() => {
				feedback.setAttribute("hidden", "");
			}, 5000);
		}
	}

	function setLoading(isLoading) {
		if (submitWrapper) {
			if (isLoading) {
				submitWrapper.setAttribute("disabled", "");
			} else {
				submitWrapper.removeAttribute("disabled");
			}
		}
		if (submitBtn) submitBtn.disabled = isLoading;
		if (spinner) {
			if (isLoading) {
				spinner.removeAttribute("hidden");
			} else {
				spinner.setAttribute("hidden", "");
			}
		}
	}

	const handleSubmit = async (event) => {
		event.preventDefault();
		event.stopPropagation();

		const formData = new FormData(form);

		setLoading(true);
		try {
			const response = await fetch(contactFormUrl, {
				method: "POST",
				body: formData,
			});

			if (response.ok) {
				showFeedback("Message sent successfully!", true);
				form.reset();
				return false;
			} else {
				const error = await response.text();
				showFeedback(`Error: ${error}`, false);
			}
		} catch (error) {
			console.error("Error submitting form:", error);
			showFeedback("An error occurred while sending your message.", false);
		} finally {
			setLoading(false);
		}
		return false;
	};

	form.addEventListener("submit", handleSubmit);
</script>
