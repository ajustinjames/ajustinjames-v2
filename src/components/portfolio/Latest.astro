---
import { render } from 'astro:content';
import { type FeedType, getFeed } from '../../utils/feed';
import Section from '../Section.astro';

// The unified stream: newest posts, notes, and links merged together so the
// home page shows a pulse between monthly long-form posts.
const entries = (await getFeed()).slice(0, 8);

// Pre-render note Markdown bodies (render() must run in frontmatter, not JSX).
const noteContents = await Promise.all(
	entries.map((entry) =>
		entry.type === 'note' && entry.noteEntry
			? render(entry.noteEntry).then((r) => r.Content)
			: Promise.resolve(null),
	),
);

const chipLabels: Record<FeedType, string> = {
	post: 'POST',
	note: 'TIL',
	link: 'LINK',
};

function formatDate(date: Date): string {
	return new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'UTC',
	}).format(date);
}
---

<Section
	eyebrow="Latest"
	title="Latest"
	description="Posts, notes, and links — the newest first."
	id="latest"
>
	<ul class="latest">
		{
			entries.map((entry, index) => {
				const NoteBody = noteContents[index];
				return (
					<li class="latest__entry">
						<div class="meta-row">
							<span class="chip">{chipLabels[entry.type]}</span>
							<time datetime={entry.date.toISOString()} class="meta-date">
								{formatDate(entry.date)}
							</time>
							{entry.type === 'link' && entry.domain && (
								<span class="meta-label">{entry.domain}</span>
							)}
						</div>

						{entry.type === 'note' && NoteBody && (
							<div class="prose latest__note">
								<NoteBody />
							</div>
						)}

						{entry.type === 'post' && (
							<>
								<h3 class="latest__title">
									<a href={entry.href}>{entry.title}</a>
								</h3>
								{entry.description && (
									<p class="latest__description">{entry.description}</p>
								)}
							</>
						)}

						{entry.type === 'link' && (
							<>
								<h3 class="latest__title">
									<a href={entry.href} target="_blank" rel="noopener noreferrer">
										{entry.title}
									</a>
								</h3>
								{entry.description && (
									<p class="latest__description">{entry.description}</p>
								)}
							</>
						)}
					</li>
				);
			})
		}
	</ul>
</Section>

<style>
	.latest {
		border-block: 1px solid var(--hl-alias-surface-border);
	}

	.latest__entry {
		padding-block: 1.5rem;
	}

	.latest__entry + .latest__entry {
		border-top: 1px solid var(--hl-alias-surface-border);
	}

	.latest__note {
		margin-top: 0.5rem;
	}

	.latest__title {
		margin-top: 0.5rem;
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.025em;
		color: var(--hl-alias-text-main);
	}

	.latest__title a:hover {
		color: var(--hl-alias-action-bg-primary);
	}

	.latest__description {
		margin-top: 0.25rem;
		color: var(--hl-alias-text-muted);
	}
</style>
