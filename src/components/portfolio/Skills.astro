---
import Section from "../Section.astro";

const skills: { label: string; items: string[] }[] = [
	{ label: "Languages", items: ["C#", "TypeScript", "Java", "SQL"] },
	{
		label: "Frameworks",
		items: [".NET Core", "Angular", "Flutter", "Playwright"],
	},
	{ label: "DevOps", items: ["Docker", "Kubernetes", "Terraform", "Git"] },
	{ label: "Tools", items: ["VS Code", "Swagger", "Android Studio", "MySQL"] },
];
---

<Section id="skills" eyebrow="Skills" title="Technical Skills">
	<dl class="border-t border-borderLight dark:border-borderDark">
		{
			skills.map((group) => (
				<div class="grid grid-cols-1 gap-2 border-b border-borderLight dark:border-borderDark py-5 md:grid-cols-[10rem_1fr] md:gap-6">
					<dt class="font-mono text-sm uppercase tracking-widest text-lightTextSecondary dark:text-darkTextSecondary">
						{group.label}
					</dt>
					<dd class="flex flex-wrap gap-2">
						{group.items.map((item) => (
							<hl-tag>{item.toUpperCase()}</hl-tag>
						))}
					</dd>
				</div>
			))
		}
	</dl>
</Section>
