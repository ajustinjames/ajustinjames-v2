---
import Section from "../Section.astro";

const skills: { label: string; items: string[] }[] = [
	{ label: "Languages", items: ["C#", "TypeScript", "Java", "SQL"] },
	{
		label: "Frameworks",
		items: [".NET Core", "Angular", "Flutter", "Playwright"],
	},
	{ label: "DevOps", items: ["Docker", "Kubernetes", "Terraform", "Git"] },
	{ label: "Tools", items: ["VS Code", "Swagger", "Android Studio", "MySQL"] },
];
---

<Section id="skills" eyebrow="Skills" title="Technical Skills">
	<dl class="skills">
		{
			skills.map((group) => (
				<div class="skills__row">
					<dt class="eyebrow">{group.label}</dt>
					<dd class="skills__items">
						{group.items.map((item) => (
							<hl-tag>{item.toUpperCase()}</hl-tag>
						))}
					</dd>
				</div>
			))
		}
	</dl>
</Section>

<style>
	.skills {
		border-top: 1px solid var(--hl-alias-surface-border);
	}

	.skills__row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--hl-alias-surface-border);
	}

	.skills__items {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	@media (min-width: 48rem) {
		.skills__row {
			grid-template-columns: 10rem 1fr;
			gap: 1.5rem;
		}
	}
</style>
