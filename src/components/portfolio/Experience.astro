---
import { duration, experience, formatDate } from "../../data/experience";
import Section from "../Section.astro";

function companyRange(roles: (typeof experience)[number]["roles"]) {
	const starts = roles.map((r) => r.startYear * 12 + r.startMonth);
	const minStart = Math.min(...starts);
	const start = roles.find(
		(r) => r.startYear * 12 + r.startMonth === minStart,
	)!;

	const hasOngoing = roles.some((r) => r.endYear === null);
	if (hasOngoing) {
		return {
			start: { year: start.startYear, month: start.startMonth },
			end: null,
		};
	}

	const ends = roles.map((r) => r.endYear! * 12 + r.endMonth!);
	const maxEnd = Math.max(...ends);
	const end = roles.find((r) => r.endYear! * 12 + r.endMonth! === maxEnd)!;

	return {
		start: { year: start.startYear, month: start.startMonth },
		end: { year: end.endYear!, month: end.endMonth! },
	};
}
---

<Section id="experience" eyebrow="Experience" title="Work Experience">
	<div class="experience">
		{
			experience.map((company) => {
				const range = companyRange(company.roles);
				const multiRole = company.roles.length > 1;
				return (
					<article class="hl-card-shell">
						<div class="split">
							<h3 class="card-title">{company.company}</h3>
							<p class="meta-date dates">
								{formatDate(range.start.year, range.start.month)} –{" "}
								{range.end
									? formatDate(range.end.year, range.end.month)
									: "Present"}
							</p>
						</div>
						<p class="meta-label company__location">{company.location}</p>
						<div class="roles">
							{company.roles.map((role) => {
								const current = role.endYear === null;
								return (
									<div class:list={["role", current && "role--current"]}>
										<div class="split">
											<h4 class="role__title">{role.title}</h4>
											{multiRole && (
												<p class="meta-date dates dates--role">
													{formatDate(role.startYear, role.startMonth)} –{" "}
													{role.endYear !== null
														? formatDate(role.endYear, role.endMonth!)
														: "Present"}{" "}
													{duration(
														{ year: role.startYear, month: role.startMonth },
														role.endYear !== null
															? { year: role.endYear, month: role.endMonth! }
															: null,
													)}
												</p>
											)}
										</div>
										{role.details.length > 0 && (
											<ul class="role__details">
												{role.details.map((detail) => (
													<li>{detail}</li>
												))}
											</ul>
										)}
										{role.technologies.length > 0 && (
											<div class="role__tech">
												{role.technologies.map((tech) => (
													<hl-tag>{tech.toUpperCase()}</hl-tag>
												))}
											</div>
										)}
									</div>
								);
							})}
						</div>
					</article>
				);
			})
		}
	</div>
</Section>

<style>
	.experience {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* Title on the left, dates on the right; stacked on phones. */
	.split {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.dates {
		white-space: nowrap;
	}

	.dates--role {
		font-size: 0.75rem;
		line-height: 1rem;
	}

	.company__location {
		margin-top: 0.25rem;
	}

	.roles {
		margin-top: 1rem;
	}

	.role {
		padding-block: 1rem;
	}

	.role:first-child {
		padding-top: 0;
	}

	.role:last-child {
		padding-bottom: 0;
	}

	.role:not(:last-child) {
		border-bottom: 1px solid var(--hl-alias-surface-border);
	}

	.role--current {
		border-left: 2px solid var(--hl-alias-action-bg-primary);
		padding-left: 1rem;
	}

	.role--current:not(:last-child) {
		border-bottom-color: var(--hl-alias-action-bg-primary);
	}

	.role__title {
		font-weight: 500;
		color: var(--hl-alias-text-main);
	}

	.role__details {
		margin-top: 0.5rem;
		padding-left: 1.25rem;
		list-style: disc;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--hl-alias-text-muted);
	}

	.role__details > li + li {
		margin-top: 0.25rem;
	}

	.role__tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	@media (min-width: 40rem) {
		.split {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
		}

		.dates {
			text-align: right;
		}
	}
</style>
