---
import { Icon } from "astro-icon/components";
const currentPath = Astro.url.pathname;

const navLinkClass =
	"font-mono text-sm tracking-wide uppercase hover:text-primary motion-safe:transition-colors aria-[current=page]:text-primary aria-[current=page]:underline aria-[current=page]:decoration-primary aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8";
---

<header class="border-b border-borderLight dark:border-borderDark">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<nav
			class="flex h-16 items-center justify-between"
			aria-label="Main navigation"
		>
			<a
				href="/"
				class="flex items-center gap-2 text-xl font-semibold hover:text-primary transition-colors"
				id="home"
				aria-label="ajustinjames - return to homepage"
			>
				<span class="inline-block h-4 w-4 bg-primary" aria-hidden="true"></span>
				ajustinjames
			</a>
			<div class="flex gap-6 items-center">
				<ul class="flex gap-8 items-center">
					<li class="flex items-center">
						<a
							href="/projects"
							class={navLinkClass}
							aria-current={currentPath === "/projects" ? "page" : undefined}
							>Projects</a
						>
					</li>
					<li class="flex items-center">
						<a
							href="/blog"
							class={navLinkClass}
							aria-current={currentPath.startsWith("/blog") ? "page" : undefined}
							>Blog</a
						>
					</li>
				</ul>
				<div class="flex items-center">
					<button
						id="theme-toggle"
						class="hover:text-primary text-lg flex items-center transition-colors"
						onclick="toggleTheme()"
						aria-label="Toggle dark mode"
						aria-pressed="false"
						type="button"
					>
						<Icon
							name="line-md:sunny"
							size="22px"
							class="dark:hidden"
							aria-hidden="true"
						/>
						<Icon
							name="line-md:moon"
							size="22px"
							class="hidden dark:block"
							aria-hidden="true"
						/>
					</button>
				</div>
			</div>
		</nav>
	</div>
</header>
