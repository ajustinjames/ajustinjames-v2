---
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

const navLinks = [
	{ href: "/projects", label: "Projects", current: currentPath === "/projects" },
	{ href: "/apps", label: "Apps", current: currentPath.startsWith("/apps") },
	{ href: "/blog", label: "Blog", current: currentPath.startsWith("/blog") },
];
---

<header class="site-header">
	<div class="site-header__inner">
		<nav class="site-header__nav" aria-label="Main navigation">
			<a
				href="/"
				class="site-header__home"
				id="home"
				aria-label="ajustinjames - return to homepage"
			>
				<img
					src="/ajlogo.svg"
					alt=""
					class="site-header__logo"
					aria-hidden="true"
				/>
				<span class="site-header__name">ajustinjames</span>
			</a>
			<div class="site-header__actions">
				<ul class="site-header__links">
					{
						navLinks.map((link) => (
							<li class="site-header__item">
								<a
									href={link.href}
									class="site-header__link"
									aria-current={link.current ? "page" : undefined}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
				<button
					id="theme-toggle"
					class="site-header__theme"
					onclick="toggleTheme()"
					aria-label="Toggle dark mode"
					aria-pressed="false"
					type="button"
				>
					<span class="site-header__sun">
						<Icon name="line-md:sunny" size="22px" aria-hidden="true" />
					</span>
					<span class="site-header__moon">
						<Icon name="line-md:moon" size="22px" aria-hidden="true" />
					</span>
				</button>
			</div>
		</nav>
	</div>
</header>

<style>
	/* Class names carry a site-header prefix because this header also renders
	   on /apps pages, next to each app's own global CSS. */
	.site-header {
		border-bottom: 1px solid var(--hl-alias-surface-border);
	}

	.site-header__inner {
		max-width: 80rem;
		margin-inline: auto;
		padding-inline: 1rem;
	}

	.site-header__nav {
		display: flex;
		height: 4rem;
		align-items: center;
		justify-content: space-between;
	}

	.site-header__home {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.25rem;
		line-height: 1.75rem;
		font-weight: 600;
		transition: color 0.15s;
	}

	.site-header__logo {
		width: 2rem;
		height: 2rem;
	}

	:global([data-theme="dark"]) .site-header__logo {
		filter: invert(1);
	}

	.site-header__name {
		display: none;
	}

	.site-header__actions,
	.site-header__links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.site-header__item {
		display: flex;
		align-items: center;
	}

	.site-header__link {
		font-family: var(--hl-alias-font-technical);
		font-size: 0.875rem;
		line-height: 1.25rem;
		letter-spacing: 0.025em;
		text-transform: uppercase;
	}

	.site-header__link[aria-current="page"] {
		color: var(--hl-alias-action-bg-primary);
		text-decoration: underline;
		text-decoration-color: var(--hl-alias-action-bg-primary);
		text-decoration-thickness: 2px;
		text-underline-offset: 8px;
	}

	.site-header__theme {
		display: flex;
		align-items: center;
		font-size: 1.125rem;
		line-height: 1.75rem;
		cursor: pointer;
		transition: color 0.15s;
	}

	.site-header__home:hover,
	.site-header__link:hover,
	.site-header__theme:hover {
		color: var(--hl-alias-action-bg-primary);
	}

	.site-header__sun {
		display: flex;
	}

	.site-header__moon {
		display: none;
	}

	:global([data-theme="dark"]) .site-header__sun {
		display: none;
	}

	:global([data-theme="dark"]) .site-header__moon {
		display: flex;
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header__link {
			transition: color 0.15s;
		}
	}

	@media (min-width: 430px) {
		.site-header__name {
			display: inline;
		}
	}

	@media (min-width: 40rem) {
		.site-header__inner {
			padding-inline: 1.5rem;
		}

		.site-header__actions {
			gap: 1.5rem;
		}

		.site-header__links {
			gap: 2rem;
		}
	}

	@media (min-width: 64rem) {
		.site-header__inner {
			padding-inline: 2rem;
		}
	}
</style>
